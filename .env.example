# =====================================================================
# Sensum Content Manager — configuration template
# ---------------------------------------------------------------------
# Copy this file to the PRIVATE cms folder as ".env" and fill it in:
#   local development:  cms/.env
#   production:         /home/<cpanel-user>/sensum-cms/.env  (outside public_html)
# Never commit a filled-in copy. Never put the real file inside public_html.
# Every value is optional unless marked REQUIRED.
# =====================================================================

# --- Application ------------------------------------------------------
# "production" (default) or "development". Production forces secure cookies.
APP_ENV=production
# REQUIRED — public address of the site, no trailing slash. Used for links in
# e-mails and to verify that admin requests come from the site itself.
APP_URL=https://sensumconstrucciones.com
APP_TIMEZONE=America/Guatemala
# Optional server secret (64 hex chars) used to pseudonymize IPs/e-mails in
# logs and throttling. If empty, one is generated into storage/app.key.
APP_KEY=
# Only needed if the cms folder is NOT next to public_html, e.g.
# PUBLIC_DIR=/home/<cpanel-user>/public_html
PUBLIC_DIR=
# Extra origins allowed to call the API (comma-separated). Leave empty in production.
EXTRA_ALLOWED_ORIGINS=

# --- First administrator (browser setup) --------------------------------
# Only if you cannot run "php cms/bin/console create-admin". Set a long
# random value (>= 24 characters), open https://<site>/admin/#/configurar,
# create the administrator, then REMOVE this line. Setup closes forever as
# soon as one user exists.
SETUP_TOKEN=

# --- Sessions & links ---------------------------------------------------
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=60

# --- E-mail (SMTP) ------------------------------------------------------
# MAIL_DRIVER: smtp | log (write .eml files to storage/mail, nothing sent) | disabled
MAIL_DRIVER=smtp
SMTP_HOST=
# 587 with SMTP_ENCRYPTION=tls (STARTTLS), or 465 with SMTP_ENCRYPTION=ssl
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_ADDRESS=no-reply@sensumconstrucciones.com
SMTP_FROM_NAME="Sensum Construcciones"
SMTP_TIMEOUT=15

# --- Support ("Reportar un problema") -----------------------------------
# Where issue reports from the Content Manager are e-mailed.
SUPPORT_EMAIL=it@gruposensum.com

# --- Monitoring, error log and critical-error alerts ------------------------
# The owner account: the only one that sees Monitoring and the error log,
# and that other administrators cannot demote, disable or delete.
OWNER_EMAIL=it@gruposensum.com
# Critical errors (server errors, PHP fatal errors, failing health checks)
# are e-mailed here. The same error at most once per cooldown; daily cap.
ALERTS_ENABLED=true
ALERT_EMAIL=it@gruposensum.com
ALERT_COOLDOWN_MINUTES=60
ALERT_DAILY_MAX=20
# How long the error log is kept, and the free-disk warning threshold.
ERROR_LOG_DAYS=180
DISK_WARN_MB=500

# --- Uploads --------------------------------------------------------------
# Maximum photo size in MB (PHP's own upload_max_filesize/post_max_size also apply).
UPLOAD_MAX_MB=10

# --- Automatic translation ES <-> EN (optional) ---------------------------
# DeepL API key (https://www.deepl.com/pro-api, "DeepL API Free": 500,000
# characters/month). Keys ending in ":fx" use the Free endpoint automatically.
# Empty = the panel doesn't offer automatic translation. SECRET — never commit.
DEEPL_API_KEY=
# Safety cap on characters sent to DeepL per day (all users together).
TRANSLATE_DAILY_CHAR_LIMIT=60000

# --- Telemetry (all OFF by default; see docs/CONTENT_MANAGER.md) -------------
# Report JavaScript errors from the PUBLIC site to the dashboard (first-party,
# no cookies, no personal data). Republish after changing.
PUBLIC_ERROR_REPORTING=false
# Cloudflare Web Analytics token (32 hex chars). Also requires the CSP change
# and privacy-notice update described in the docs. Republish after changing.
CF_WEB_ANALYTICS_TOKEN=
