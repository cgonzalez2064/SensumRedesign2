# Content Manager API: every /api/* request goes to index.php.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>
# Only the front controller may run here.
<FilesMatch "^(?!index\.php$).+$">
  Require all denied
</FilesMatch>
Options -Indexes
