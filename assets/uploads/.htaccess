# Photos and documents published from the Content Manager. File names are
# generated by the server; only these image/PDF types are ever served, and
# nothing in this folder can run as code.
Options -Indexes -ExecCGI
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .shtml
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
</IfModule>
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "^[a-z0-9-]+-w[0-9]+\.(webp|jpg)$|^[a-z0-9-]+\.pdf$">
  Require all granted
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.pdf$">
    Header set Content-Disposition "attachment"
    Header set Content-Security-Policy "sandbox"
  </FilesMatch>
</IfModule>
