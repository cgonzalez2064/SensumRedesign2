{
  "name": "sensum-site-tests",
  "private": true,
  "description": "Development-only test tooling for the Sensum website and Content Manager. Never uploaded to the server.",
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 \"integration/*.test.mjs\"",
    "test:visual": "playwright test --config visual/playwright.config.js",
    "test:visual:update": "playwright test --config visual/playwright.config.js --update-snapshots",
    "test:e2e": "playwright test --config e2e/playwright.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0"
  }
}
